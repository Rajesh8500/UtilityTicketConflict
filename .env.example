# Copy to .env for local use and replace the dummy password with your local PostgreSQL password.
# Never put real credentials in this example file or commit .env.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=utility_tickets_dev
DB_USER=postgres
DB_PASSWORD=change-me-locally
DB_SSL=false
DB_TIMEZONE=UTC

API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api
